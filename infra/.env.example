# ============================================================================
# Plantilla de configuración de infraestructura.
#
# Copiar a `.env` y rellenar. **`.env` está en el .gitignore y nunca se versiona.**
#
#   cd infra && cp .env.example .env
#
# Las claves de abajo son de EJEMPLO. Genera las tuyas con:
#   openssl rand -base64 24
# ============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=stock
POSTGRES_USER=stock_app
POSTGRES_PASSWORD=CAMBIA_ESTO_por_una_clave_generada
POSTGRES_PORT=5432

# ── Adminer (visor de BD) ──────────────────────────────────────────────────
ADMINER_PORT=8080

# ── Cadena de conexión que usa el backend ──────────────────────────────────
# Formato JDBC. El backend la lee de su propio entorno.
DATABASE_URL=jdbc:postgresql://localhost:5432/stock
DATABASE_USER=stock_app
DATABASE_PASSWORD=CAMBIA_ESTO_por_una_clave_generada

# ── Secretos de aplicación ─────────────────────────────────────────────────
# Firma de JWT. Genera una distinta por entorno. NUNCA la de producción.
APP_SECRET=CAMBIA_ESTO_por_un_secreto_de_al_menos_32_caracteres

# Clave para el hash de API keys de servicio (integración ERP y Zebra).
SERVICE_KEY_PEPPER=CAMBIA_ESTO_por_otro_secreto
