<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de logging del backend.

  En producción el formato es JSON (lo activa STOCK_LOG_FORMAT=json), porque los
  agregadores de logs lo parsean sin expresiones regulares frágiles. En
  desarrollo es texto legible.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- El pool de conexiones es muy hablador en DEBUG. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="io.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
