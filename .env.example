# Copia a .env y completa los valores. .env no se versiona.
# Ninguna variable de secreto tiene valor por defecto: sin ella, Compose no arranca.

POSTGRES_DB=stock
POSTGRES_USER=stock_app
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=
# Puerto del host para PostgreSQL (solo 127.0.0.1)
POSTGRES_PORT=
