# Copia a .env y completa los valores. .env no se versiona.
# Ninguna variable de secreto tiene valor por defecto: sin ella, Compose no arranca.

POSTGRES_DB=stock
# Puerto del host para PostgreSQL (solo 127.0.0.1)
POSTGRES_PORT=5434

# Dueño del esquema. Solo lo usa el servicio `migrate`.
DB_OWNER_USER=stock_owner
# Generar con: openssl rand -hex 24
DB_OWNER_PASSWORD=

# Usuario de la API. Miembro del rol `stock_api` (migración V11): no puede crear ni alterar
# tablas, ni modificar el kardex ni la bitácora.
STOCK_API_USER=stock_app
# Generar con: openssl rand -hex 24
STOCK_API_PASSWORD=

# Puerto del host para la API (solo 127.0.0.1)
API_PORT=8081

# Secreto con el que se firman los tokens de acceso. Al menos 32 bytes; conservarlo entre reinicios
# para que las sesiones abiertas sigan valiendo. Generar con: openssl rand -base64 48
STOCK_JWT_SECRET=

# Contraseña del primer administrador. SOLO se usa si la base no tiene ningún usuario; se le exige
# cambiarla al entrar. Después de crear al administrador se puede dejar vacía.
# Mínimo 12 caracteres, y que no sea una contraseña común.
ADMIN_BOOTSTRAP_PASSWORD=

# Zona horaria de la operación: en ella se evalúan las políticas de horario.
STOCK_BUSINESS_ZONE=America/Mexico_City

# Puerto del host para la web (solo 127.0.0.1)
WEB_PORT=8085
