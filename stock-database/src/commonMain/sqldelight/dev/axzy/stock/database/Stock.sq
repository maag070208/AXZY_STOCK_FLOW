-- ============================================================================
-- ESQUEMA DE LA BASE LOCAL DEL MÓVIL (SQLite)
--
-- Para qué existe: el uso real es en el piso del almacén con señal
-- intermitente. Sin esto, el móvil «falla sin red» —que es exactamente lo que
-- hacía el legacy— y el operador apunta en papel.
--
-- DECISIONES QUE EXPLICAN EL ESQUEMA
--
-- 1. Las cantidades se guardan en MILÉSIMAS ENTERAS, igual que el dominio.
--    Un `REAL` de SQLite es coma flotante binaria: 0.1 + 0.2 != 0.3, y en un
--    inventario eso son descuadres que aparecen semanas después. El transporte
--    usa decimales (contrato §1.7) y la conversión ocurre en la frontera.
--
-- 2. `operacion_pendiente.idempotency_key` es **UNIQUE**. La cola es idempotente
--    por construcción, no por disciplina del código: aunque el móvil reintente
--    o el usuario pulse dos veces, la clave repetida no crea una segunda fila.
--    Además de la PRIMARY KEY, hay un índice único explícito con nombre para
--    que el conflicto sea legible en un error.
--
-- 3. Se usa `INSERT OR REPLACE` / `INSERT OR IGNORE` y no `ON CONFLICT DO
--    UPDATE` (UPSERT) porque el UPSERT exige SQLite 3.24, que llega con Android
--    8.0, y el `minSdk` de este proyecto es 24 (Android 7.0). La sintaxis
--    moderna dejaría el móvil de bodega sin poder guardar nada, y el fallo
--    aparecería en el arranque de la app, no en el build.
--
-- 4. No hay claves foráneas: la caché se reemplaza por lotes cuando el
--    catálogo cambia, y una FK convertiría ese reemplazo en un orden de
--    borrado que nadie recuerda. Lo que protege la coherencia es que la API es
--    la fuente maestra y la caché se reescribe entera.
-- ============================================================================

-- ── Catálogo de productos ───────────────────────────────────────────────────
CREATE TABLE producto (
    id                INTEGER NOT NULL PRIMARY KEY,
    codigo            TEXT    NOT NULL UNIQUE,
    nombre            TEXT    NOT NULL,
    descripcion       TEXT,
    unidad_medida     TEXT    NOT NULL,
    external_id       INTEGER,
    activo            INTEGER NOT NULL DEFAULT 1,
    -- Existencias totales derivadas, en milésimas.
    stock_milesimas   INTEGER NOT NULL DEFAULT 0,
    actualizado_en    INTEGER NOT NULL
);

-- ── Bodegas ─────────────────────────────────────────────────────────────────
CREATE TABLE almacen (
    id                INTEGER NOT NULL PRIMARY KEY,
    codigo            TEXT    NOT NULL,
    nombre            TEXT    NOT NULL,
    es_predeterminada INTEGER NOT NULL DEFAULT 0,
    activo            INTEGER NOT NULL DEFAULT 1
);

-- ── Ubicaciones ─────────────────────────────────────────────────────────────
CREATE TABLE ubicacion (
    id                INTEGER NOT NULL PRIMARY KEY,
    almacen_id        INTEGER NOT NULL,
    almacen_codigo    TEXT,
    -- Etiqueta legible, "04-B-C": es lo que está impreso en el estante.
    nombre_visible    TEXT    NOT NULL,
    -- SHELF o RECEIVING. La de recepción es real, con id real (no la
    -- pseudo-ubicación ADMIN con identificador ficticio del legacy).
    tipo              TEXT    NOT NULL,
    activa            INTEGER NOT NULL DEFAULT 1,
    actualizado_en    INTEGER NOT NULL
);

-- ── Existencias por producto y ubicación ────────────────────────────────────
CREATE TABLE existencia (
    producto_id       INTEGER NOT NULL,
    ubicacion_id      INTEGER NOT NULL,
    codigo_producto   TEXT    NOT NULL,
    nombre_ubicacion  TEXT    NOT NULL,
    almacen_id        INTEGER NOT NULL,
    cantidad_milesimas INTEGER NOT NULL DEFAULT 0,
    actualizado_en    INTEGER NOT NULL,
    PRIMARY KEY (producto_id, ubicacion_id)
);

-- ── Cola de sincronización ──────────────────────────────────────────────────
-- Cada fila es una operación que se capturó sin (o con mala) señal y que hay
-- que reenviar EXACTAMENTE UNA VEZ.
CREATE TABLE operacion_pendiente (
    id               INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    -- La clave que viaja en la cabecera `Idempotency-Key` (contrato §1.5).
    idempotency_key  TEXT    NOT NULL,
    -- CAPTURA_LINEA, UBICACION, AJUSTE, EMPAQUE, CONFIRMACION_ORDEN, EXPORTACION_ERP.
    tipo             TEXT    NOT NULL,
    metodo           TEXT    NOT NULL,
    ruta             TEXT    NOT NULL,
    -- El cuerpo JSON ya construido, tal como lo enviará el cliente HTTP.
    cuerpo           TEXT    NOT NULL,
    -- PENDIENTE, EN_CURSO, FALLIDA, COMPLETADA.
    estado           TEXT    NOT NULL DEFAULT 'PENDIENTE',
    intentos         INTEGER NOT NULL DEFAULT 0,
    ultimo_error     TEXT,
    creada_en        INTEGER NOT NULL,
    -- Se añade en la versión 2 (ver 1.sqm): sin ella no se puede aplicar
    -- backoff exponencial, porque no se sabe cuándo se intentó por última vez.
    ultimo_intento_en INTEGER
);

-- El índice único es la garantía de idempotencia. `INSERT OR IGNORE` choca
-- contra él y no crea una segunda operación con la misma clave.
CREATE UNIQUE INDEX idx_operacion_pendiente_clave
    ON operacion_pendiente(idempotency_key);

-- El worker pide siempre «las pendientes más antiguas»: sin este índice,
-- recorrería la cola entera en cada ciclo.
CREATE INDEX idx_operacion_pendiente_estado
    ON operacion_pendiente(estado, creada_en);

-- ════════════════════════════════════════════════════════════════════════════
-- CONSULTAS DEL CATÁLOGO
-- ════════════════════════════════════════════════════════════════════════════

insertarProducto:
INSERT OR REPLACE INTO producto(
    id, codigo, nombre, descripcion, unidad_medida, external_id, activo,
    stock_milesimas, actualizado_en
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

productoPorId:
SELECT * FROM producto WHERE id = ?;

productoPorCodigo:
SELECT * FROM producto WHERE codigo = ?;

buscarProductos:
SELECT * FROM producto
WHERE activo = 1 AND (codigo LIKE :patron OR nombre LIKE :patron)
ORDER BY codigo
LIMIT :limite;

listarProductos:
SELECT * FROM producto ORDER BY codigo;

contarProductos:
SELECT count(*) FROM producto;

borrarProductos:
DELETE FROM producto;

-- ════════════════════════════════════════════════════════════════════════════
-- CONSULTAS DE ALMACENES Y UBICACIONES
-- ════════════════════════════════════════════════════════════════════════════

insertarAlmacen:
INSERT OR REPLACE INTO almacen(id, codigo, nombre, es_predeterminada, activo)
VALUES (?, ?, ?, ?, ?);

listarAlmacenes:
SELECT * FROM almacen ORDER BY codigo;

borrarAlmacenes:
DELETE FROM almacen;

insertarUbicacion:
INSERT OR REPLACE INTO ubicacion(
    id, almacen_id, almacen_codigo, nombre_visible, tipo, activa, actualizado_en
) VALUES (?, ?, ?, ?, ?, ?, ?);

ubicacionPorId:
SELECT * FROM ubicacion WHERE id = ?;

listarUbicaciones:
SELECT * FROM ubicacion ORDER BY nombre_visible;

listarUbicacionesDeAlmacen:
SELECT * FROM ubicacion WHERE almacen_id = ? ORDER BY nombre_visible;

contarUbicaciones:
SELECT count(*) FROM ubicacion;

borrarUbicaciones:
DELETE FROM ubicacion;

-- ════════════════════════════════════════════════════════════════════════════
-- CONSULTAS DE EXISTENCIAS
-- ════════════════════════════════════════════════════════════════════════════

insertarExistencia:
INSERT OR REPLACE INTO existencia(
    producto_id, ubicacion_id, codigo_producto, nombre_ubicacion, almacen_id,
    cantidad_milesimas, actualizado_en
) VALUES (?, ?, ?, ?, ?, ?, ?);

existenciasDeProducto:
SELECT * FROM existencia WHERE producto_id = ? ORDER BY nombre_ubicacion;

existenciasDeUbicacion:
SELECT * FROM existencia WHERE ubicacion_id = ? ORDER BY codigo_producto;

-- El total se DERIVA de las ubicaciones, igual que en el backend: guardarlo
-- aparte sería la forma de que un día no cuadre.
totalDeProducto:
SELECT coalesce(sum(cantidad_milesimas), 0) FROM existencia WHERE producto_id = ?;

existenciasConStock:
SELECT * FROM existencia WHERE cantidad_milesimas > 0 ORDER BY codigo_producto;

listarExistencias:
SELECT * FROM existencia ORDER BY codigo_producto;

borrarExistencias:
DELETE FROM existencia;

-- ════════════════════════════════════════════════════════════════════════════
-- CONSULTAS DE LA COLA DE SINCRONIZACIÓN
-- ════════════════════════════════════════════════════════════════════════════

-- `OR IGNORE` contra el índice único: reencolar la MISMA clave no duplica nada.
encolarOperacion:
INSERT OR IGNORE INTO operacion_pendiente(
    idempotency_key, tipo, metodo, ruta, cuerpo, estado, intentos,
    ultimo_error, creada_en, ultimo_intento_en
) VALUES (?, ?, ?, ?, ?, ?, 0, NULL, ?, NULL);

operacionPorClave:
SELECT * FROM operacion_pendiente WHERE idempotency_key = ?;

operacionPorId:
SELECT * FROM operacion_pendiente WHERE id = ?;

-- El worker toma las más antiguas y solo las que están pendientes o fallidas:
-- una operación EN_CURSO no se vuelve a enviar mientras se está enviando.
operacionesPorEnviar:
SELECT * FROM operacion_pendiente
WHERE estado IN ('PENDIENTE', 'FALLIDA')
ORDER BY creada_en
LIMIT ?;

operacionesPorEstado:
SELECT * FROM operacion_pendiente WHERE estado = ? ORDER BY creada_en;

listarOperaciones:
SELECT * FROM operacion_pendiente ORDER BY creada_en;

contarOperacionesPorEstado:
SELECT count(*) FROM operacion_pendiente WHERE estado = ?;

marcarOperacionEnCurso:
UPDATE operacion_pendiente SET estado = 'EN_CURSO' WHERE id = ?;

marcarOperacionCompletada:
UPDATE operacion_pendiente SET estado = 'COMPLETADA', ultimo_error = NULL WHERE id = ?;

-- El intento se cuenta SIEMPRE que se envía, y se guarda CUÁNDO: es lo que
-- permite aplicar backoff exponencial en lugar de martillear el servidor.
registrarIntentoFallido:
UPDATE operacion_pendiente
SET estado = 'FALLIDA',
    intentos = intentos + 1,
    ultimo_error = :error,
    ultimo_intento_en = :ahora
WHERE id = :id;

borrarOperacionesCompletadas:
DELETE FROM operacion_pendiente WHERE estado = 'COMPLETADA';

borrarTodasLasOperaciones:
DELETE FROM operacion_pendiente;
