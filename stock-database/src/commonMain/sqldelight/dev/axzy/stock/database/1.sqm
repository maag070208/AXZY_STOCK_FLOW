-- ============================================================================
-- MIGRACIÓN 1 → 2
--
-- POR QUÉ ESTA MIGRACIÓN EXISTE (y no es un ejemplo de relleno)
--
-- La cola de sincronización necesita **backoff exponencial**: si el servidor
-- está caído, reintentar cada segundo desde veinte móviles a la vez es un
-- ataque de denegación de servicio hecho por nosotros mismos. Para calcular el
-- siguiente intento hay que saber CUÁNDO se intentó el último.
--
-- `ultimo_intento_en` no estaba en la versión 1 del esquema. Un móvil que ya
-- está en el piso, con operaciones encoladas sin señal, NO puede reinstalar la
-- base: perdería la cola, que es el trabajo del operador. De ahí que haga falta
-- una migración de verdad y no un `DROP TABLE`.
--
-- CÓMO SE APLICA
--   · El esquema de `Stock.sq` es SIEMPRE la versión más reciente (2).
--   · Esta migración lleva una base en la versión 1 al estado de la 2.
--   · `asegurarEsquema` (OfflineStockDatabase.kt) decide entre crear y migrar
--     leyendo `PRAGMA user_version`, en commonMain y con un test que la
--     ejecuta sobre una base v1 con datos dentro.
--
-- `ALTER TABLE ... ADD COLUMN` es aditivo y no reescribe la tabla: conserva
-- todas las operaciones encoladas, que es justo lo que no se puede perder.
-- ============================================================================

ALTER TABLE operacion_pendiente ADD COLUMN ultimo_intento_en INTEGER;

-- El índice pasa a incluir el estado y la fecha de creación porque el worker
-- pregunta «pendientes o fallidas, las más antiguas primero» en cada ciclo.
CREATE INDEX idx_operacion_pendiente_estado ON operacion_pendiente(estado, creada_en);
