// Configuración del proyecto iOS.
//
// TEAM_ID queda VACÍO a propósito: sin un equipo de firma configurado, el proyecto
// compila y corre en SIMULADOR, que es donde se valida la UI. Rellenarlo es un paso
// de despliegue, y poner un identificador de equipo inventado aquí rompería la
// compilación de cualquiera que no sea el dueño de ese equipo.
TEAM_ID=

PRODUCT_NAME=AlmacenIntegral
PRODUCT_BUNDLE_IDENTIFIER=dev.axzy.stock.mobile$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=0.1.0
