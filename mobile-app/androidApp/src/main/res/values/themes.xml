<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema del sistema para el arranque (splash).

  POR QUÉ NO ES UN TEMA DE COMPOSE: antes de que Compose dibuje el primer fotograma,
  Android pinta el `windowBackground` con este tema. Si el fondo fuera el blanco por
  defecto, al abrir la app desde cero se vería un destello blanco antes de la interfaz
  — y en un almacén con luz baja eso deslumbra justo cuando el operador mira la
  pantalla.
-->
<resources>
    <style name="Theme.AlmacenIntegral" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
